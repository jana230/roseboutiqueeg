:root {
  --pink-bg: #d86885;
  --pink-light: #f7d2dc;
  --pink-accent: #c74a6d;
  --text-dark: #111111;
  --bg-white: #faf8f8;
  --border-color: #eee;
  --danger: #dc3545;
}

* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Cairo', sans-serif; }
body { background-color: var(--bg-white); color: var(--text-dark); overflow-x: hidden; }

.loading-overlay { position: fixed; inset: 0; background: rgba(255,255,255,0.95); display: none; align-items: center; justify-content: center; z-index: 9999; }
.loading-overlay.active { display: flex; }
.spinner { width: 50px; height: 50px; border: 4px solid var(--pink-light); border-top-color: var(--pink-bg); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

#toast-container { position: fixed; top: 80px; left: 20px; z-index: 9998; display: flex; flex-direction: column; gap: 10px; }
.toast { background: #fff; padding: 14px 20px; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.1); border-right: 4px solid #28a745; animation: slideIn 0.3s ease; min-width: 250px; font-size: 14px; }
.toast.error { border-right-color: var(--danger); }
@keyframes slideIn { from { transform: translateX(-100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

.navbar { display: flex; justify-content: space-between; align-items: center; padding: 15px 40px; background: #fff; border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 1000; gap: 15px; flex-wrap: wrap; }
.nav-links { display: flex; gap: 20px; align-items: center; }
.nav-link { color: #555; font-size: 14px; font-weight: 600; cursor: pointer; padding: 6px 12px; border-radius: 20px; }
.nav-link:hover, .nav-link.active { background: var(--pink-light); color: var(--pink-accent); }
.brand-logo-text { font-weight: 900; font-size: 22px; color: var(--pink-accent); text-decoration: none; letter-spacing: 1px; }
.nav-actions { display: flex; gap: 10px; align-items: center; }
.cart-btn { background: var(--pink-bg); color: #fff; border: none; padding: 8px 16px; border-radius: 20px; font-weight: bold; cursor: pointer; }
.admin-link-btn { background: #111; color: #fff; border: none; padding: 8px 18px; border-radius: 30px; font-size: 12px; font-weight: bold; cursor: pointer; }

.hero-section { position: relative; height: 70vh; min-height: 450px; display: flex; flex-direction: column; justify-content: center; align-items: center; background: #fff; overflow: hidden; padding: 20px; }
.hero-title-back { font-size: clamp(3rem, 11vw, 11vw); font-weight: 900; color: #111; letter-spacing: -2px; white-space: nowrap; user-select: none; }
.hero-product-img { position: absolute; width: clamp(200px, 30vw, 340px); top: 50%; left: 50%; transform: translate(-50%, -55%); z-index: 2; filter: drop-shadow(0 20px 30px rgba(0,0,0,0.15)); }
.hero-footer { position: absolute; bottom: 30px; width: 85%; display: flex; justify-content: space-between; align-items: flex-end; z-index: 3; gap: 15px; flex-wrap: wrap; }
.btn-pill { background: var(--pink-bg); color: #fff; border: none; padding: 12px 28px; border-radius: 30px; cursor: pointer; font-weight: 700; text-decoration: none; display: inline-block; }

.features-section { display: flex; justify-content: space-around; padding: 25px; background: #fff; border-bottom: 1px solid var(--border-color); text-align: center; flex-wrap: wrap; gap: 15px; }
.feature-item { font-size: 14px; font-weight: bold; color: var(--pink-accent); }

.collections-section { padding: 50px 40px; background: #fff; }
.section-title { text-align: center; font-size: 28px; font-weight: 900; margin-bottom: 25px; }
.collections-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
.collection-card { position: relative; height: 260px; border-radius: 25px; overflow: hidden; display: flex; align-items: flex-end; padding: 25px; background-size: cover; background-position: center; transition: 0.3s ease; background-color: #f0f0f0; }
.collection-card::before { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.75), transparent); }
.collection-card:hover { transform: translateY(-5px); }
.collection-content { position: relative; z-index: 2; color: #fff; width: 100%; }
.collection-content h3 { font-size: 22px; font-weight: 800; margin-bottom: 5px; }
.collection-content p { font-size: 12px; opacity: 0.9; margin-bottom: 12px; }

.subcategories-bar { display: none; justify-content: center; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
.sub-btn { background: var(--pink-light); color: var(--pink-accent); border: none; padding: 8px 18px; border-radius: 20px; font-weight: bold; cursor: pointer; font-size: 13px; }
.sub-btn.active { background: var(--pink-accent); color: #fff; }

.featured-banner-section { background-color: var(--pink-bg); padding: 50px 30px; border-radius: 35px; margin: 20px; color: #fff; }
.banner-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; gap: 15px; flex-wrap: wrap; }
.products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 20px; }
.pink-card { background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px); border-radius: 25px; padding: 20px; border: 1px solid rgba(255, 255, 255, 0.4); color: #111; position: relative; }
.pink-card img { width: 100%; height: 180px; object-fit: contain; }
.eco-badge { font-size: 11px; background: rgba(255, 255, 255, 0.7); padding: 4px 10px; border-radius: 12px; font-weight: bold; }
.stock-badge { font-size: 11px; background: #111; color: #fff; padding: 3px 8px; border-radius: 10px; float: left; }
.stock-badge.out { background: var(--danger); }
.card-details { display: flex; justify-content: space-between; align-items: center; margin-top: 15px; gap: 10px; flex-wrap: wrap; }
.btn-pill-small { background: #fff; color: var(--text-dark); border: none; padding: 8px 16px; border-radius: 20px; font-size: 12px; font-weight: bold; cursor: pointer; }
.btn-pill-small:hover { background: var(--pink-accent); color: #fff; }
.btn-pill-small:disabled { opacity: 0.5; cursor: not-allowed; }

.payment-notice-box { background: #fff3f5; border: 2px dashed var(--pink-accent); padding: 15px; border-radius: 15px; margin-bottom: 20px; text-align: center; }

.btn-action { border: none; padding: 6px 12px; border-radius: 8px; font-size: 11px; font-weight: bold; cursor: pointer; margin-top: 5px; }
.btn-delete { background: var(--danger); color: #fff; }
.admin-panel { display: none; background: #fff; padding: 30px; border-radius: 25px; margin: 40px; border: 2px solid var(--text-dark); }
.admin-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; }
.admin-box { background: var(--bg-white); padding: 20px; border-radius: 15px; border: 1px solid var(--border-color); }
.form-group { margin-bottom: 12px; }
.form-group label { display: block; font-weight: 700; font-size: 13px; margin-bottom: 4px; }
.form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 8px; font-family: inherit; font-size: 14px; }
.btn-submit { background: var(--text-dark); color: #fff; border: none; padding: 12px; border-radius: 8px; font-weight: bold; cursor: pointer; width: 100%; font-family: inherit; }

.modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 2000; align-items: center; justify-content: center; padding: 15px; }
.modal.active { display: flex; }
.modal-content { background: #fff; padding: 30px; border-radius: 20px; width: 90%; max-width: 500px; max-height: 90vh; overflow-y: auto; }

.table-custom { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; min-width: 600px; }
.table-custom th, .table-custom td { padding: 8px; border: 1px solid #ddd; text-align: center; }
.table-custom th { background: var(--pink-light); }

@media (max-width: 768px) {
  .navbar { padding: 10px 15px; }
  .nav-links { order: 3; width: 100%; justify-content: center; padding-top: 10px; border-top: 1px solid var(--border-color); }
  .hero-section { height: auto; min-height: 500px; padding: 30px 15px 100px; }
  .hero-title-back { font-size: 15vw; }
  .hero-product-img { width: 65vw; max-width: 260px; }
  .hero-footer { position: absolute; bottom: 20px; width: 90%; flex-direction: column; align-items: center; text-align: center; }
  .collections-section { padding: 30px 15px; }
  .collections-grid { grid-template-columns: 1fr; }
  .featured-banner-section { padding: 30px 15px; margin: 15px 10px; }
  .products-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .pink-card { padding: 12px; }
  .pink-card img { height: 130px; }
  .admin-panel { margin: 15px 10px; padding: 15px; }
  .admin-grid { grid-template-columns: 1fr; }
}
